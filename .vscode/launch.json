{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open CSC3209 App",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "CSC3209 static server running at (http://.*)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
